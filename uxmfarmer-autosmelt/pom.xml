<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.blokoyun.hooks</groupId><artifactId>uxmfarmer-autosmelt-parent</artifactId><version>1.0.0</version>
    </parent>
    <artifactId>uxmfarmer-autosmelt</artifactId>
    <name>uxmFarmerOtoEritme</name>
    <description>Automatic same-storage ore smelting with a Farmer-style menu.</description>
    <dependencies>
        <dependency><groupId>com.blokoyun.hooks</groupId><artifactId>hook-common</artifactId><version>${project.version}</version></dependency>
        <dependency><groupId>io.papermc.paper</groupId><artifactId>paper-api</artifactId><version>${paper.version}</version><scope>provided</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><version>${junit.version}</version><scope>test</scope></dependency>
        <dependency><groupId>org.mockito</groupId><artifactId>mockito-core</artifactId><version>${mockito.version}</version><scope>test</scope></dependency>
    </dependencies>
    <build>
        <finalName>uxmFarmerOtoEritme</finalName>
        <resources>
            <resource><directory>${project.basedir}/src/main/resources</directory><filtering>false</filtering>
                <excludes><exclude>plugin.yml</exclude></excludes>
            </resource>
            <resource><directory>${project.basedir}/src/main/resources</directory><filtering>true</filtering>
                <includes><include>plugin.yml</include></includes>
            </resource>
            <resource>
                <directory>${project.basedir}/..</directory>
                <targetPath>META-INF</targetPath>
                <includes><include>LICENSE</include></includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-shade-plugin</artifactId><version>3.6.0</version>
                <executions><execution><phase>package</phase><goals><goal>shade</goal></goals><configuration>
                    <createDependencyReducedPom>false</createDependencyReducedPom>
                    <shadedArtifactAttached>false</shadedArtifactAttached>
                    <relocations><relocation><pattern>com.blokoyun.hooks.common</pattern><shadedPattern>com.blokoyun.hooks.farmersmelt.internal.common</shadedPattern></relocation></relocations>
                    <artifactSet><includes><include>com.blokoyun.hooks:hook-common</include></includes></artifactSet>
                </configuration></execution></executions>
            </plugin>
        </plugins>
    </build>
</project>
